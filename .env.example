# 로컬 개발/디버깅용 환경변수 템플릿.
# 이 파일을 `.env`로 복사한 뒤 값을 채우세요. (.env는 커밋되지 않습니다)
#
#   cp .env.example .env
#
# VS Code / IntelliJ 실행 구성과 `./gradlew bootRun`, `./gradlew test`가 이 파일을 읽습니다.

# 로컬 5433 Postgres의 integration 계정 비밀번호 (필수)
DB_PASSWORD=

# 아래는 application.yml에 기본값이 있으므로 필요할 때만 덮어쓰세요.
# DB_URL=jdbc:postgresql://localhost:5433/integration
# DB_USER=integration
# JWT_SECRET=dev-only-insecure-secret-please-override-32bytes-min
# JWT_EXPIRATION_MINUTES=1440

# Web Push (VAPID). 비워두면 푸시 알림만 비활성화되고 나머지 API는 정상 동작합니다.
# 키 쌍 생성: ./gradlew -q vapidKeys
# 공개키를 바꾸면 기존 브라우저 구독이 전부 무효화되므로 환경별로 한 번만 생성해 고정하세요.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:big9401@gmail.com

# 회의록 녹음 전달용 n8n 웹훅. 비워두면 업로드만 503으로 막히고 나머지 API는 정상입니다.
# 이 값들은 절대 프론트엔드(.env.production 등)로 옮기지 마세요 — VITE_* 는 빌드 시점에
# 번들로 인라인되어 방문자 누구나 읽을 수 있습니다. 그래서 서버로 옮긴 것입니다.
N8N_RECORDING_WEBHOOK_URL=
# n8n Webhook 노드에 Header Auth를 걸어뒀을 때만 채우세요. 웹훅을 내부망에만
# 열어뒀다면 비워둬도 됩니다.
N8N_RECORDING_KEY=

# 서버-대-서버 내부 호출 키. n8n이 저장 성공/실패를 /internal/push 로 알려올 때 검증합니다.
# 비워두면 /internal/push 가 전부 403(fail-closed)이라 실수로 열리지 않습니다.
# n8n의 Header Auth(X-Internal-Key) 값과 반드시 같아야 합니다.
INTERNAL_API_KEY=
