# 로컬 개발/디버깅용 환경변수 템플릿.
# 이 파일을 `.env`로 복사한 뒤 값을 채우세요. (.env는 커밋되지 않습니다)
#
#   cp .env.example .env
#
# VS Code / IntelliJ 실행 구성과 `./gradlew bootRun`, `./gradlew test`가 이 파일을 읽습니다.

# 로컬 5433 Postgres의 integration 계정 비밀번호 (필수)
DB_PASSWORD=

# 아래는 application.yml에 기본값이 있으므로 필요할 때만 덮어쓰세요.
# DB_URL=jdbc:postgresql://localhost:5433/integration
# DB_USER=integration
# JWT_SECRET=dev-only-insecure-secret-please-override-32bytes-min
# JWT_EXPIRATION_MINUTES=1440

# Web Push (VAPID). 비워두면 푸시 알림만 비활성화되고 나머지 API는 정상 동작합니다.
# 키 쌍 생성: ./gradlew -q vapidKeys
# 공개키를 바꾸면 기존 브라우저 구독이 전부 무효화되므로 환경별로 한 번만 생성해 고정하세요.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:big9401@gmail.com

# 회의록 녹음 전달용 n8n 웹훅. 비워두면 업로드만 503으로 막히고 나머지 API는 정상입니다.
# 이 값들은 절대 프론트엔드(.env.production 등)로 옮기지 마세요 — VITE_* 는 빌드 시점에
# 번들로 인라인되어 방문자 누구나 읽을 수 있습니다. 그래서 서버로 옮긴 것입니다.
N8N_RECORDING_WEBHOOK_URL=
# n8n Webhook 노드에 Header Auth를 걸어뒀을 때만 채우세요. 웹훅을 내부망에만
# 열어뒀다면 비워둬도 됩니다.
N8N_RECORDING_KEY=

# 서버-대-서버 내부 호출 키. n8n이 저장 성공/실패를 /internal/push 로 알려올 때 검증합니다.
# 비워두면 /internal/push 가 전부 403(fail-closed)이라 실수로 열리지 않습니다.
# n8n의 Header Auth(X-Internal-Key) 값과 반드시 같아야 합니다.
INTERNAL_API_KEY=

# Claude API — G2 안경 "Claude에게 묻기" (/api/ai/ask). 비워두면 이 기능만 503으로 꺼지고
# 나머지 API는 정상입니다. 키는 console.anthropic.com 에서 발급하며, 절대 프론트로 옮기지 마세요.
# 운영(Jenkins)에서는 Deploy 단계 withCredentials 목록에 이 두 값을 함께 넣어야 합니다.
ANTHROPIC_API_KEY=
# 이 기능을 쓸 수 있는 계정의 로그인 이메일(쉼표로 여러 개). 앱은 스토어에 공개되지만
# Claude 비용은 키 주인이 내므로, 비워두면 키가 있어도 아무도 못 씁니다(fail-closed).
AI_ALLOWED_EMAILS=

# 아래는 application.yml에 기본값이 있으므로 필요할 때만 덮어쓰세요.
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=medium                 # low면 더 빠르고 쌉니다
# AI_DAILY_LIMIT=100               # 계정당 하루 질문 수
# AI_GLOBAL_DAILY_LIMIT=300        # 서버 전체 하루 질문 수
# AI_CONTEXT_FILE=/path/to/project-context.txt   # 프로젝트 자료(있으면 "내 프로젝트를 아는 Claude")
# AI_WORKSPACE_ROOT=/var/lib/momentum-ai/projects  # Claude가 읽을 프로젝트(GitHub 클론·zip) 보관 폴더. 기본 ~/.momentum-ai/projects
# 비공개 GitHub 저장소용 읽기 전용 토큰. github.com → Settings → Developer settings →
# Fine-grained tokens 에서 저장소를 고르고 권한은 Contents: Read-only 만 주세요. 비우면 공개 저장소만.
# AI_GITHUB_TOKEN=

# 안경 마이크로 묻기 — 서버 음성 인식(whisper.cpp). `sudo bash scripts/install-whisper.sh` 로 설치하면
# 아래 기본 경로에 깔리므로 따로 넣을 필요가 없습니다. 없으면 마이크 기능만 꺼집니다.
# AI_WHISPER_BIN=/opt/whisper/bin/whisper-cli
# AI_WHISPER_MODEL=/opt/whisper/models/ggml-small.bin
# AI_WHISPER_THREADS=4
